# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron job security (set een willekeurige geheime string)
CRON_SECRET=

# Outlook/Microsoft Graph webhook
OUTLOOK_WEBHOOK_SECRET=

# Overleggen-koppeling (transcriptie-tool → Nerve). Lange willekeurige string,
# bijv. via: openssl rand -hex 32. Dezelfde waarde vul je in de transcriptie-app in.
MEETINGS_WEBHOOK_SECRET=
# Optioneel: vaste Supabase user-id voor binnenkomende overleggen
# (anders de eerste gebruiker, net als bij Outlook)
NERVE_USER_ID=
